{
  "manifest_version": 3,
  "name": "markdown-editor",
  "version": "2.0.0",
  "description": "View and edit .md URLs offline. Save edits as a downloaded Markdown file.",
  "permissions": ["downloads", "offscreen", "storage"],
  "incognito": "split",
  "action": {
    "default_title": "markdown-editor",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*",
        "http://*/*.md*",
        "https://*/*.md*"
      ],
      "js": [
        "vendor/marked.js",
        "vendor/purify.js",
        "vendor/markdown-editor.js",
        "storage-client.js",
        "save-picker.js",
        "viewer.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
